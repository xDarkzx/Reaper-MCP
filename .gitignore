# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Per-machine VST/AU parameter scan cache (fx_scan_params) - tied to
# whatever plugin versions are actually installed locally; shipping one
# machine's scan results to everyone else risks distributing a stale
# mapping for a plugin version they don't even have.
reaper_mcp_shared/plugin_maps/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Claude
.claude/
.mcp.json

# Secrets — never commit API keys
Groq_API.md
*.api_key
.env
.env.*

# Large local asset folders (user's MIDI, datasets, renders)
Midi_References/
datasets/
midi_output/
librescore_midi/
dl-librescore/

# Local scratch notes — future ideas not yet designed/committed to
docs/FUTURE_IDEAS.md

# Local screenshots and scratch files (root-level only)
/Screenshot*.png
/_*.json
/_*.txt
/_*.py
/*.mid
/*.musicxml

# Any sibling archive / scratch folders kept locally (root-level only)
/_archive*/
/Composer-Engine-Archive/

# Local tool/session artifacts, not project source
.agents/
.cookie
.tmp_song/
.tmp_song_gen.py
